{
  "name": "@insurance/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/app.test.ts",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/migrations/migrate-cli.ts",
    "db:seed": "tsx src/database/seed-cli.ts",
    "db:verify:phase1": "tsx src/database/verify-phase1.ts"
  },
  "dependencies": {
    "@insurance/contracts": "*",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "mongodb": "7.6.0",
    "@google/genai": "^0.1.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5"
  }
}
