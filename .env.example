MONGODB_URI=mongodb://127.0.0.1:27017/insurance?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=insurance
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
AUTH_SECRET=replace-with-at-least-32-random-characters
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=80

# Chat provider: keep "local" for offline approved answers, or use "gemini".
CHAT_PROVIDER=local
# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000
